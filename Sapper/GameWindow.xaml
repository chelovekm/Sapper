<Window x:Class="Sapper.GameWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sapper"
        mc:Ignorable="d"
        Title="Сапер - Игра" Height="600" Width="700" ResizeMode="NoResize" WindowStartupLocation="CenterScreen" Closing="Window_Closing">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10" Background="#F0F0F0">
            <Button x:Name="btnBackToMenu" Content="Меню" Width="80" Height="30" Margin="0 0 10 0" Click="btnBackToMenu_Click"/>
            
            <Separator Width="20" Visibility="Hidden"/>
            
            <TextBlock Text="Мины:" VerticalAlignment="Center" Margin="15 0 5 0"/>
            <TextBlock x:Name="tbMines" Text="0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>
            
            <Separator Width="20" Visibility="Hidden"/>
            
            <TextBlock Text="Время:" VerticalAlignment="Center" Margin="15 0 5 0"/>
            <TextBlock x:Name="tbTime" Text="0" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>
            
            <Separator Width="20" Visibility="Hidden"/>
            
            <TextBlock Text="Поле:" VerticalAlignment="Center" Margin="15 0 5 0"/>
            <TextBlock x:Name="tbGridSize" Text="10 x 10" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="16"/>
        </StackPanel>
        
        <Border Grid.Row="1" BorderBrush="DarkGray" BorderThickness="2" Margin="10" Background="#FFFFFF" Padding="0">
            <Viewbox Stretch="Uniform">
                <UniformGrid x:Name="gameGrid" Rows="10" Columns="10" Background="DarkGray"/>
            </Viewbox>
        </Border>
        
        <TextBlock x:Name="tbStatus" Grid.Row="2" Margin="13" FontSize="20" FontWeight="Bold" Text="Кликните для начала!" HorizontalAlignment="Center"/>
    </Grid>
</Window>
