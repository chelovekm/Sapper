<Window x:Class="Sapper.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Sapper"
        mc:Ignorable="d"
        Title="Сапер - Меню" Height="750" Width="500" ResizeMode="NoResize" WindowStartupLocation="CenterScreen">
    <Grid Background="#F5F5F5">
        <Border Background="White" CornerRadius="10" Padding="30" Margin="20">
            <Border.Effect>
                <DropShadowEffect Color="Gray" BlurRadius="10" ShadowDepth="3" Opacity="0.3"/>
            </Border.Effect>
            <StackPanel>
                <TextBlock Text="САПЕР" FontSize="36" FontWeight="Bold" HorizontalAlignment="Center" Margin="0 0 0 20" Foreground="#2C3E50"/>
                
                <Button x:Name="btnNewGame" Content="Новая игра" Height="35" Margin="0 5" FontSize="14" Background="#3498DB" Foreground="White" BorderThickness="0" Click="btnNewGame_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#2980B9"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>

                <Button x:Name="btnContinueGame" Content="Продолжить игру" Height="35" Margin="0 5" FontSize="14" Background="#27AE60" Foreground="White" BorderThickness="0" Click="btnContinueGame_Click" IsEnabled="False">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.5"/>
                                    <Setter Property="Background" Value="#95A5A6"/>
                                </Trigger>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#229954"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
                
                <Separator Margin="0 15"/>
                
                <Grid Margin="0 5">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    
                    <StackPanel Grid.Column="0" Margin="0 0 10 0">
                        <TextBlock Text="Строки:" FontSize="12" Margin="0 0 0 5" Foreground="#7F8C8D"/>
                        <TextBox x:Name="tbFieldRows" Height="30" Text="5" FontSize="14" VerticalAlignment="Center" Padding="5"/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="10 0 0 0">
                        <TextBlock Text="Столбцы:" FontSize="12" Margin="0 0 0 5" Foreground="#7F8C8D"/>
                        <TextBox x:Name="tbFieldCols" Height="30" Text="5" FontSize="14" VerticalAlignment="Center" Padding="5"/>
                    </StackPanel>
                </Grid>
                
                <TextBlock Text="Процент мин:" FontSize="12" Margin="0 10 0 5" Foreground="#7F8C8D"/>
                <ComboBox x:Name="cbDifficulty" Height="30" Margin="0 0 0 5" FontSize="14">
                    <ComboBoxItem Content="20%" Tag="0.2"/>
                    <ComboBoxItem Content="30%" Tag="0.3" IsSelected="True"/>
                    <ComboBoxItem Content="40%" Tag="0.4"/>
                </ComboBox>
                
                <TextBlock Text="Формат сохранения:" FontSize="12" Margin="0 10 0 5" Foreground="#7F8C8D"/>
                <ComboBox x:Name="cbSaveFormat" Height="30" Margin="0 0 0 5" FontSize="14" SelectionChanged="cbSaveFormat_SelectionChanged">
                    <ComboBoxItem Content="JSON" Tag="json" IsSelected="True"/>
                    <ComboBoxItem Content="XML" Tag="xml"/>
                </ComboBox>
                
                <TextBlock Text="Имя файла:" FontSize="12" Margin="0 10 0 5" Foreground="#7F8C8D"/>
                <TextBox x:Name="tbFileName" Height="30" Text="save" FontSize="14" VerticalAlignment="Center" Padding="5" Margin="0 0 0 5" TextChanged="tbFileName_TextChanged"/>
                
                <TextBlock Text="Папка сохранений:" FontSize="12" Margin="0 10 0 5" Foreground="#7F8C8D"/>
                <Grid Margin="0 0 0 5">
                    <TextBox x:Name="tbSaveFolder" Height="30" Text="" FontSize="14" VerticalAlignment="Center" Padding="5"/>
                    <Button x:Name="btnBrowseFolder" Content="..." Width="35" Height="30" HorizontalAlignment="Right" Background="#95A5A6" Foreground="White" BorderThickness="0" Click="btnBrowseFolder_Click">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="0,3,3,0" Padding="5">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="#7F8C8D"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </Grid>
                
                <Separator Margin="0 15"/>
                
                <Button x:Name="btnHighScores" Content="Топ лидеров" Height="35" Margin="0 5" FontSize="14" Background="#E67E22" Foreground="White" BorderThickness="0" Click="btnHighScores_Click">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="Button">
                                        <Border Background="{TemplateBinding Background}" CornerRadius="5" Padding="10">
                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#D68910"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</Window>
